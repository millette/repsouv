{
  "name": "@repsouv/scripts",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millette/repsouv.git",
    "directory": "packages/scripts"
  },
  "homepage": "https://millette.github.io/repsouv/",
  "author": {
    "name": "Robin Millette",
    "email": "robin@millette.info",
    "url": "https://robin.millette.info/"
  },
  "type": "module",
  "scripts": {
    "update": "node update.ts",
    "sommaire": "node sommaire.ts",
    "test": "nub run test:unit && nub run test:data && nub run schemas:verifier",
    "test:unit": "nub --test \"test/*.test.ts\"",
    "test:data": "nub --test \"test/donnees/*.test.ts\"",
    "typecheck": "tsrs -p .",
    "schemas": "obuild && nub dist/generer-schemas.mjs",
    "schemas:verifier": "obuild && nub dist/generer-schemas.mjs --verifier"
  },
  "dependencies": {
    "linkedom": "^0.18.15",
    "spdx-expression-parse": "^5.0.0",
    "spdx-license-ids": "^3.0.24"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "nub",
      "version": "^0.11.0",
      "onFail": "ignore"
    }
  },
  "devDependencies": {
    "@mionjs/bin-compiler": "0.14.0",
    "@mionjs/devtools": "0.14.0",
    "@mionjs/run-types": "0.14.0",
    "@nubjs/types": "^0.10.0",
    "@types/node": "^26.6.6",
    "@types/spdx-expression-parse": "^4.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "obuild": "0.4.45",
    "tsrs": "^0.24.0-ts7.1.0-beta",
    "vega": "^6.4.0",
    "vega-lite": "^6.5.0"
  }
}
