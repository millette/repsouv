// Signalement de la provenance d'un champ, en texte visible: jamais par la couleur seule ni au survol (FR-017).
import { LIBELLES_PROVENANCE, type Provenance } from "../lib/provenance.ts";

interface Props {
  type: Provenance;
  /** Précision ajoutée au libellé (date de lecture, par exemple). */
  complement?: string;
}
const { type, complement } = Astro.props;
---
<span class={`provenance provenance-${type}`}>{LIBELLES_PROVENANCE[type]}{complement ? `, ${complement}` : ""}</span>
