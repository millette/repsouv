{
  "name": "@repsouv/site",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millette/repsouv.git",
    "directory": "packages/site"
  },
  "homepage": "https://millette.github.io/repsouv/",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "nub run test:unit && nub run test:build",
    "test:unit": "nub --test \"test/*.test.ts\"",
    "test:build": "nub --test --test-concurrency=1 \"test/build/*.test.ts\"",
    "test:e2e": "nub run build && nub run build:base && playwright test",
    "build:base": "SITE_URL=https://millette.github.io SITE_BASE=/repsouv/ astro build --outDir dist-base"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.5",
    "astro": "^7.4.11",
    "daisyui": "^5.7.50",
    "satteri": "^0.11.7",
    "solid-js": "^1.9.19",
    "vega": "catalog:",
    "vega-lite": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/cli": "^0.1.24",
    "@playwright/test": "1.64.1",
    "@types/node": "catalog:",
    "linkedom": "catalog:",
    "postcss": "^8.5.32",
    "typescript": "6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "nub",
      "version": "^0.11.0",
      "onFail": "ignore"
    }
  }
}
