{
  "name": "spike-mion",
  "private": true,
  "type": "module",
  "description": "Spike: les schémas JSON de mion RunTypes décrivent-ils le JSON réellement échangé?",
  "devDependencies": {
    "@mionjs/bin-compiler": "0.14.0",
    "@mionjs/devtools": "0.14.0",
    "@mionjs/run-types": "0.14.0",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "ts-json-schema-generator": "2.9.1-next.18",
    "typescript": "6.0.3"
  },
  "scripts": {
    "schema:tjs": "ts-json-schema-generator --path types.ts --type Message --tsconfig tsconfig.json -o schemas/tjs.schema.json",
    "construire": "nub construire-mion.ts",
    "comparer": "nub comparer.ts",
    "complement": "nub complement.ts",
    "typecheck": "../node_modules/.bin/tsrs -p ."
  }
}
