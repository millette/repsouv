{
  "name": "outils-souverainete-numerique",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millette/repsouv.git"
  },
  "homepage": "https://millette.github.io/repsouv/",
  "author": {
    "name": "Robin Millette",
    "email": "robin@millette.info",
    "url": "https://robin.millette.info/"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@nubjs/types": "^0.10.0",
      "@types/node": "^26.6.6",
      "linkedom": "^0.18.15",
      "tsrs": "^0.24.0-ts7.1.0-beta",
      "vega": "^6.4.0",
      "vega-lite": "^6.5.0"
    }
  },
  "scripts": {
    "update": "node packages/scripts/update.ts",
    "sommaire": "node packages/scripts/sommaire.ts",
    "test": "nub run -F @repsouv/commun test && nub run -F @repsouv/scripts test",
    "test:unit": "nub run -F @repsouv/commun test && nub run -F @repsouv/scripts test:unit",
    "test:data": "nub run -F @repsouv/scripts test:data",
    "typecheck": "nub run -F @repsouv/commun typecheck && nub run -F @repsouv/scripts typecheck",
    "schemas": "nub run -F @repsouv/scripts schemas",
    "schemas:verifier": "nub run -F @repsouv/scripts schemas:verifier",
    "licences": "uvx reuse lint",
    "site:dev": "nub run -F @repsouv/site dev",
    "site:build": "nub run -F @repsouv/site build",
    "site:check": "nub run -F @repsouv/site check",
    "site:test": "nub run -F @repsouv/site test",
    "site:test:e2e": "nub run -F @repsouv/site test:e2e"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "nub",
      "version": "^0.11.0",
      "onFail": "ignore"
    }
  }
}
