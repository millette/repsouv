  },
  "type": "module",
  "scripts": {
    "sommaire": "nub sommaire.ts",
    "schemas": "obuild && nub dist/generer-schemas.mjs",
    "licences": "uvx reuse lint",
    "schemas:verifier": "obuild && nub dist/generer-schemas.mjs --verifier",
    "update": "nub update.ts",
    "test": "nub test/classify.test.ts && nub test/confirmer.test.ts && nub test/extract.test.ts && nub test/update.test.ts && nub test/enrichir.test.ts && nub test/progress.test.ts && nub test/spdx.test.ts && nub test/prix.test.ts && nub test/en-tetes.test.ts && nub test/documentation.test.ts && nub test/fichiers.test.ts && nub test/temps.test.ts && nub test/sommaire.test.ts && nub test/couleurs.test.ts && nub test/graphiques.test.ts && nub test/schemas.test.ts && nub run schemas:verifier",
    "typecheck": "tsrs -p ."
  },
  "dependencies": {
    "linkedom": "^0.18.15",
    "spdx-expression-parse": "^5.0.0",
    "spdx-license-ids": "^3.0.24",
    "vega": "^6.4.0",
    "vega-lite": "^6.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.10.0",
      "onFail": "ignore"
    }
  },
  "devDependencies": {
    "@mionjs/bin-compiler": "0.14.0",
    "@mionjs/devtools": "0.14.0",
    "@mionjs/run-types": "0.14.0",
    "@nubjs/types": "^0.10.0",
    "@types/node": "^26.6.6",
    "@types/spdx-expression-parse": "^4.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "obuild": "0.4.45",
    "tsrs": "^0.24.0-ts7.1.0-beta"
  }
}
