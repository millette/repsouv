{
  "name": "site-outils-souverainete-numerique",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "nub run test:unit && nub run test:build",
    "test:unit": "nub --test \"test/*.test.ts\"",
    "test:build": "nub --test \"test/build/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.5",
    "astro": "^7.4.11",
    "daisyui": "^5.7.50",
    "satteri": "^0.11.7",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "linkedom": "^0.18.15",
    "postcss": "^8.5.32",
    "typescript": "6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "nub",
      "version": "^0.10.0",
      "onFail": "ignore"
    }
  }
}
