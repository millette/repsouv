// Carte d'un outil dans la liste: nom lié à sa fiche, score, statut du code source s'il est connu, description courte.
// Un champ absent ne laisse aucun emplacement vide.
import { adresseFiche, identifiant } from "../lib/adresses.ts";
import type { OutilClasse } from "../lib/donnees.ts";
import { LIBELLES_STATUT } from "../lib/libelles.ts";
import Etoiles from "./Etoiles.astro";
import Provenance from "./Provenance.astro";

interface Props {
  outil: OutilClasse;
  base: string;
}
const { outil, base } = Astro.props;
const id = identifiant(outil.nom);
---
<li class="carte-outil card card-border" data-outil={id}>
  <div class="card-body">
    <h3 class="card-title"><a class="link link-hover" href={adresseFiche(id, base)}>{outil.nom}</a></h3>
    <p class="carte-meta">
      <Etoiles score={outil.score} estime={outil.score_estime === true} />
      {outil.source && <span class="statut"><span class="badge badge-outline">{LIBELLES_STATUT[outil.source]}</span> <Provenance type="ia" /></span>}
    </p>
    <p class="carte-description">{outil.description}</p>
  </div>
</li>
