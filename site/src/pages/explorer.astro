---
// SPDX-License-Identifier: AGPL-3.0-or-later
// SPDX-FileCopyrightText: 2026 Robin Millette <https://robin.millette.info/>
// Page « Explorer »: l'explorateur interactif (île SolidJS). C'est la seule page qui demande JavaScript: sans lui,
// le contenu d'attente reste affiché, le dit et renvoie à la page « Outils »
// (specs/002-explorateur-outils/contracts/pages.md). Un <noscript> ne suffirait pas: certains navigateurs où les
// scripts sont bloqués ne l'affichent pas.
import Page from "../layouts/Page.astro";
import { adresseOutils } from "../lib/adresses.ts";
import { site } from "../lib/site.ts";

const { base } = site();
---
<Page titre="Explorer les outils" description="Trier, filtrer et comparer les outils du répertoire." courante="explorer">
  <h1>Explorer les outils</h1>
  <!-- Contenu d'attente: remplacé par l'explorateur dès qu'il est monté. Sans JavaScript, il reste affiché. -->
  <p class="alert" role="status" data-attente>
    Chargement des outils… L'explorateur demande JavaScript pour trier, filtrer et comparer les outils ; sans lui, la liste complète se lit sur la page
    <a class="link" href={adresseOutils(base)}>Outils</a>.
  </p>
</Page>
