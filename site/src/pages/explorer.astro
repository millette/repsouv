// Page « Explorer »: la liste complète des outils, lisible sans JavaScript, et l'explorateur interactif (île SolidJS
// montée dès le chargement) qui la remplace par ses résultats triés, filtrés et comparés
// (specs/002-explorateur-outils, second amendement du 2026-11-13).
import Explorateur from "../components/Explorateur.tsx";
import ListeOutils from "../components/ListeOutils.astro";
import Page from "../layouts/Page.astro";
import { adresseDonnees } from "../lib/chargement.ts";
import { donneesExplorateur } from "../lib/explorateur.ts";
import { site } from "../lib/site.ts";

const donnees = site();
const { outils, ...referentiels } = donneesExplorateur(donnees);
---
<Page titre="Explorer les outils" description="Tous les outils du répertoire, à trier, filtrer et comparer." courante="explorer">
  <h1>Explorer les outils</h1>
  <p class="introduction">
    Tous les outils du répertoire. Les étoiles, sur 3, comptent les critères de souveraineté que l'outil satisfait : où restent les données, qui contrôle
    l'outil, de qui il dépend. Avec JavaScript, « Trier et filtrer » permet aussi de comparer des outils côte à côte.
  </p>
  <Explorateur client:load adresseDonnees={adresseDonnees(donnees.base)} base={donnees.base} referentiels={{ ...referentiels, ids: outils.map((o) => o.id) }} />
  <ListeOutils />
</Page>
