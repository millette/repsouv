// Page « Outils »: tous les outils actifs, par catégorie, lisibles sans JavaScript. Elle n'a ni filtre ni île: trier,
// filtrer et comparer se font dans l'explorateur (specs/002-explorateur-outils/contracts/pages.md).
import CarteOutil from "../../components/CarteOutil.astro";
import Provenance from "../../components/Provenance.astro";
import Page from "../../layouts/Page.astro";
import { adresseExplorer } from "../../lib/adresses.ts";
import { groupesParCategorie } from "../../lib/repertoire.ts";
import { site } from "../../lib/site.ts";

const { categories, actifs, base } = site();
const groupes = groupesParCategorie(categories, actifs);
---
<Page titre="Outils" description="Tous les outils du répertoire, par catégorie, avec leur score et le statut de leur code source." courante="outils">
  <h1>Outils</h1>
  <p class="introduction">
    Tous les outils du répertoire, par catégorie. Les étoiles, sur 3, comptent les critères de souveraineté que l'outil satisfait : où restent les données, qui
    contrôle l'outil, de qui il dépend.
  </p>
  <p class="compteur">{actifs.length} outils, en {groupes.length} catégories. <a class="link" href={adresseExplorer(base)}>Trier, filtrer et comparer les outils</a></p>
  {groupes.map(({ categorie, outils }) => (
    <section class="categorie" data-categorie={categorie.id} aria-labelledby={`categorie-${categorie.id}`}>
      <h2 id={`categorie-${categorie.id}`}><span aria-hidden="true">{categorie.icone}</span> {categorie.nom}</h2>
      {categorie.description && <p class="categorie-description">{categorie.description} <Provenance type="ia" /></p>}
      <ul class="cartes">
        {outils.map((outil) => <CarteOutil outil={outil} base={base} />)}
      </ul>
    </section>
  ))}
</Page>
