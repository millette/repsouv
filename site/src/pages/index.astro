---
// SPDX-License-Identifier: AGPL-3.0-or-later
// SPDX-FileCopyrightText: 2026 Robin Millette <https://robin.millette.info/>
// Accueil: présentation du projet (ce qu'est le répertoire, sa genèse, les crédits, les logiciels utilisés). La liste
// des outils est sur la page « Explorer », avec le tri et les filtres. Les nombres viennent des données;
// le reste, de la documentation du dépôt (src/lib/presentation.ts).
import Page from "../layouts/Page.astro";
import { adresseExplorer } from "../lib/adresses.ts";
import { formaterDate } from "../lib/libelles.ts";
import { ETAPES, LOGICIELS } from "../lib/presentation.ts";
import { LIBELLES_PROVENANCE } from "../lib/provenance.ts";
import { groupesParCategorie } from "../lib/repertoire.ts";
import { AUTEURS_PRAXIS, ID_PRAXIS, LICENCE_DONNEES, NOM_SITE, site } from "../lib/site.ts";

const { categories, criteres, sources, actifs, base } = site();
const nbCategories = groupesParCategorie(categories, actifs).length;
const praxis = sources.find((s) => s.id === ID_PRAXIS)!;
const autres = sources.filter((s) => s.id !== ID_PRAXIS);
const parSource = (id: string) => actifs.filter((o) => o.source_repertoire_id === id).length;
---
<Page description="Un répertoire d'outils numériques évalués selon trois critères de souveraineté, pour les organismes et les petites équipes du Canada français." courante="accueil">
  <h1>{NOM_SITE}</h1>

  <section class="section-accueil" aria-labelledby="titre-repertoire">
    <h2 id="titre-repertoire">Le répertoire</h2>
    <p>
      Ce site présente {actifs.length} outils et services numériques, en {nbCategories} catégories, tirés de {sources.length} sources. Il s'adresse aux organismes et
      aux petites équipes du Canada français qui veulent savoir où vont leurs données et de qui dépendent leurs outils.
    </p>
    <p>Chaque outil reçoit de 0 à 3 étoiles, une par critère de souveraineté qu'il satisfait :</p>
    <ul class="criteres-accueil">
      {criteres.map((c) => <li><span aria-hidden="true">{c.icon}</span> {c.titre}</li>)}
    </ul>
    <p class="actions">
      <a class="btn btn-primary" href={adresseExplorer(base)}>Voir, trier et comparer les outils</a>
    </p>
  </section>

  <section class="section-accueil" aria-labelledby="titre-genese">
    <h2 id="titre-genese">Genèse</h2>
    <p>
      Le répertoire d'origine est une note publiée sur Praxis par La bande numérique, une initiative de la Fédération culturelle canadienne-française (FCCF), pour
      les OSBL des arts et de la culture du Canada français : <a class="link" href={praxis.url}><cite>Répertoire d'outils favorisant la souveraineté numérique</cite></a>.
      Ce projet en publie les données sous une forme structurée, les tient à jour, et y ajoute d'autres sources et ce que la note ne dit pas : à quel critère chaque
      étoile correspond, le statut du code source, la licence, et des critères vérifiés d'après la page de chaque outil.
    </p>
    <ol class="etapes">
      {ETAPES.map((e) => <li><strong>{formaterDate(e.date)}.</strong> {e.texte}</li>)}
    </ol>
  </section>

  <section class="section-accueil" aria-labelledby="titre-credits">
    <h2 id="titre-credits">Crédits</h2>
    <ul>
      <li>
        <strong>Répertoire d'origine</strong> ({parSource(ID_PRAXIS)} outils) : {AUTEURS_PRAXIS.slice(0, -1).join(", ")} et {AUTEURS_PRAXIS.at(-1)},
        <a class="link" href={praxis.url}>{praxis.nom}</a>.
      </li>
      {autres.map((s) => <li><strong>Autre source</strong> ({parSource(s.id)} outils) : <a class="link" href={s.url}>{s.nom}</a>.</li>)}
      <li>
        <strong>Extraction, classification, enrichissement et site</strong> : <a class="link" href="https://robin.millette.info/">Robin Millette</a>.
      </li>
      <li>
        <strong>Licences</strong> : les données sont partagées sous <a class="link" rel="license" href={LICENCE_DONNEES.url}>{LICENCE_DONNEES.nom}</a>, comme le
        répertoire d'origine ; le code est sous AGPL-3.0-or-later.
      </li>
    </ul>
    <p>
      Les champs marqués « {LIBELLES_PROVENANCE.ia} » sont rédigés par un modèle d'IA à partir des pages des outils : ils résument des pages tierces et sont à
      contrôler avant de s'y fier.
    </p>
  </section>

  <section class="section-accueil" aria-labelledby="titre-logiciels">
    <h2 id="titre-logiciels">Logiciels utilisés</h2>
    {LOGICIELS.map((groupe) => (
      <>
        <h3>{groupe.titre}</h3>
        <dl class="definitions">
          {groupe.logiciels.map((l) => <><dt><a class="link" href={l.url}>{l.nom}</a></dt><dd>{l.role}</dd></>)}
        </dl>
      </>
    ))}
  </section>
</Page>
